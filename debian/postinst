#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# pve-bindsnap postinst: check that the overlay loads through the wrappers, have the PVE
# daemons reloaded once so they pick it up (by pve-manager's trigger when it runs, else
# here), and print the guard state into the apt log.
#   configure -- after install/upgrade of this package. A failed check exits non-zero
#                and reloads nothing itself: the wrappers load the overlay eval-guarded, so the
#                node keeps stock behaviour, and apt reports the package unconfigured.
#   triggered -- after pve-container or libpve-guest-common-perl changed the upstream
#                code (see the triggers file). A failed check only WARNS: the node is
#                stock-safe, and failing here would abort the user's PVE upgrade.
set -e

SERVICES="pvedaemon pveproxy pvestatd"

# The PVE daemons and pct load these modules under perl -T (taint mode), where a module can
# fail that loads fine without it, so each check loads them the same way. On a failure perl's
# own stderr is printed (the wrapper's "overlay not loaded (...)" line names the cause).
# $1: what failed, $2: perl code that exits 0 when the load worked.
preflight_load() {
    if ! preflight_err=$(perl -T -e "$2" 2>&1 >/dev/null); then
        echo "pve-bindsnap: PRE-FLIGHT FAILED -- $1." >&2
        if [ -n "$preflight_err" ]; then
            printf '%s\n' "$preflight_err" >&2
        else
            echo "pve-bindsnap: (perl printed no error)" >&2
        fi
        return 1
    fi
}

preflight() {
    # shellcheck disable=SC2016 # perl code: its $ must reach perl unexpanded
    preflight_load 'the snapshot overlay did not apply' \
        'require PVE::LXC::Config; exit($PVE::LXC::BindSnap::APPLIED ? 0 : 1)' || return 1
    # shellcheck disable=SC2016 # perl code: its $ must reach perl unexpanded
    preflight_load 'the clone overlay did not load' \
        'require PVE::API2::LXC; exit($PVE::LXC::BindSnap::CLONE_LOADED ? 0 : 1)'
}

# The overlay prints its activation lines only from a PVE daemon writing to a non-tty
# (the journal), so present it as one: $0 named like pvedaemon, stderr into a pipe.
report() {
    perl -e '$0 = "pvedaemon"; require PVE::LXC::Config; require PVE::API2::LXC;' 2>&1 |
        grep '^pve-bindsnap:' || true
}

# reload-or-try-restart is the graceful form pve-manager uses itself: the PVE daemons
# re-exec on reload, so a GUI-started apt run is not cut off, and a stopped daemon stays
# stopped. Skipped outside a running systemd (chroot, image build).
reload_daemons() {
    [ -d "${DPKG_ROOT:-}/run/systemd/system" ] || return 0
    # shellcheck disable=SC2086 # SERVICES is a word list on purpose
    systemctl reload-or-try-restart $SERVICES || true
}

# pve-manager has a file trigger on /usr/share/perl5/PVE and reloads the PVE daemons from it
# (reload-or-try-restart) after every dpkg run that changes a file there: this package's own
# install, upgrade and removal, and every pve-container upgrade that fires this package's
# trigger. A second reload of ours a moment later can catch pveproxy mid-restart, and systemd
# then loses its main process and leaves it stopped. So the scripts reload only when that
# trigger will not: no pve-manager, its trigger not part of this dpkg run (dpkg-reconfigure),
# or one of the two conditions under which its trigger exits without reloading.
PVE_TREE=/usr/share/perl5/PVE

pve_manager_skips_reload() {
    [ -f "${DPKG_ROOT:-}/etc/pve/local/pve-ssl.pem" ] || return 0
    [ -e "${DPKG_ROOT:-}/proxmox_install_mode" ]
}

# dpkg records the activated trigger on pve-manager before this script runs and clears it
# once pve-manager has processed it. dpkg-query honours DPKG_ADMINDIR.
pve_manager_reload_pending() {
    # shellcheck disable=SC2016
    pending="$(dpkg-query -W -f='${Triggers-Pending}' pve-manager 2>/dev/null)" || return 1
    case " $pending " in
    *" $PVE_TREE "*) ;;
    *) return 1 ;;
    esac
    ! pve_manager_skips_reload
}

# Whether pve-manager's interest in the whole tree is registered. Used from this package's
# own trigger, whose paths lie under that tree: pve-manager's trigger fires in the same run,
# and may already have run, so its pending state cannot tell.
pve_manager_watches_tree() {
    grep -qxE "$PVE_TREE pve-manager(/noawait)?" "${DPKG_ADMINDIR:-/var/lib/dpkg}/triggers/File" 2>/dev/null || return 1
    ! pve_manager_skips_reload
}

left_to_pve_manager() {
    echo "pve-bindsnap: the PVE daemons are reloaded by pve-manager's trigger."
}

case "$1" in
configure)
    if ! preflight; then
        echo "pve-bindsnap: the overlay is not active; Proxmox keeps its stock behaviour, also after the daemons reload." >&2
        exit 1
    fi
    report
    if pve_manager_reload_pending; then left_to_pve_manager; else reload_daemons; fi
    ;;
triggered)
    if preflight; then
        report
    else
        echo "pve-bindsnap: WARNING -- after this upgrade the overlay does not load;" >&2
        echo "pve-bindsnap: Proxmox runs stock. Please report it: https://github.com/bitranox/pve-bindsnap/issues" >&2
    fi
    if pve_manager_watches_tree; then left_to_pve_manager; else reload_daemons; fi
    ;;
esac

exit 0
